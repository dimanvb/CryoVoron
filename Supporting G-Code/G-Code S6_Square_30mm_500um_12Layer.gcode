; Ander Reizabal 
; 2022-04-03
; DaltonLab, Eugene, US
; Square scaffold 20x20_0.5 um interspace

; Main Parameters
G21 ; (Set Units to Millimeters)

; Printhead begining possition
;G28	; (Move to Origin - Home)
G90 
G1 Z10 F3000 ; save Z height
G1 Y100 F3000 ; (avoid light collision)
G1 X23 F3000; (nozzle left back corner)
G1 Z20 
PAUSE ; clean the nozzle to remove all the visible solution - then write 'restart' 



; Set values
G1 Z1.5 ; NTCD (mm)

PAUSE ; whait the jet top be generated - write 'restart' to continue the print


G1 F2000 ; set feedrate (mm/min)
G91 ; relative positioning

; Jet loading and stabilization
G1 Y-45
G1 X1
G1 Y45
G1 X1
G1 Y-45
G1 X1
G1 Y45
G1 X1
G1 Y-45
G1 X1
G1 Y45
G1 X1
G1 Y-45
G1 X1
G1 Y45
G1 X1
G1 Y-45
G1 X1
G1 Y45
G1 X1
G1 Y-45
G1 X1
G1 Y45
G1 X1
G1 Y-42

; GLASS SLIDE transition
G1 X5


;Start Print
G1 X30.00000 Y0.00000
G4 P0 ; pause after line 
G1 F2000 ; loop speed
